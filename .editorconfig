root = true

# Base rules (matches what `dotnet format` normalizes by default)
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4

# C# specifics
[*.cs]
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_new_line_before_open_brace = all

# Suppress rules that fire on code we deliberately keep as-is.
# CA1873: logging is already structured with templates and args.
# CA1859: return-type refinement with no measurable win on the surfaces it would touch.
# xUnit2024/xUnit2025: assertion-style hints; the tests call out their intent explicitly.
dotnet_diagnostic.CA1873.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.xUnit2024.severity = none
dotnet_diagnostic.xUnit2025.severity = none

# Generated migrations are EF history: never hand-edit (CA1861 flag is on generated index code).
[src/SignalForge.Infrastructure/Migrations/*.cs]
dotnet_diagnostic.CA1861.severity = none