      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SignalForge.Application\SignalForge.Application.csproj" />
    <ProjectReference Include="..\SignalForge.Infrastructure\SignalForge.Infrastructure.csproj" />
  </ItemGroup>

