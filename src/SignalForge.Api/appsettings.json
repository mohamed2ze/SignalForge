{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Seed": {
    "Enabled": true
  },
  "RateLimiting": {
    "PermitLimit": 1000,
    "WindowSeconds": 60,
    "Store": "InMemory"
  },
  "Metrics": {
    "Enabled": true,
    "RefreshSeconds": 15
  },
  "Notifications": {
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "FromAddress": "",
      "FromDisplayName": "",
      "EnableSsl": true,
      "TimeoutSeconds": 30
    },
    "Sms": {
      "ApiBaseUrl": "",
      "ApiKeyHeader": "X-Api-Key",
      "ApiKey": "",
      "FromPhone": "",
      "TimeoutSeconds": 15
    }
  }
}