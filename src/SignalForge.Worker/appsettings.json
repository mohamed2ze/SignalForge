{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "SignalForge.Worker.Services.OutboxProcessor": "Debug"
    }
  },
  "Outbox": {
    "BatchSize": 100,
    "PollIntervalSeconds": 5,
    "MaxAttempts": 5,
    "FailureThreshold": 3,
    "MaxBackoffSeconds": 300
  },
  "ExecutionPump": {
    "BatchSize": 10,
    "PollIntervalSeconds": 2
  }
}