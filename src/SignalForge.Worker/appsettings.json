{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "SignalForge.Worker.Services.OutboxProcessor": "Debug"
    }
  },
  "Worker": {
    "GracefulShutdownTimeoutSeconds": 30
  },
  "Outbox": {
    "BatchSize": 100,
    "PollIntervalSeconds": 5,
    "MaxAttempts": 5,
    "FailureThreshold": 3,
    "MaxBackoffSeconds": 300
  },
  "ExecutionPump": {
    "BatchSize": 10,
    "PollIntervalSeconds": 2,
    "ClaimLeaseSeconds": 300
  },
  "Broker": {
    "Provider": "InMemory"
  },
  "Notifications": {
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "FromAddress": "",
      "FromDisplayName": "",
      "EnableSsl": true,
      "TimeoutSeconds": 30
    },
    "Sms": {
      "ApiBaseUrl": "",
      "ApiKeyHeader": "X-Api-Key",
      "ApiKey": "",
      "FromPhone": "",
      "TimeoutSeconds": 15
    }
  }
}